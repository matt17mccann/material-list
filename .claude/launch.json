{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pwa-app",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const h=require('http'),f=require('fs'),p=require('path'),d='/Users/matthewmccann/Desktop/material list app/pwa-app',m={'.html':'text/html','.js':'text/javascript','.json':'application/json','.css':'text/css','.svg':'image/svg+xml','.png':'image/png'};h.createServer((q,r)=>{let u=q.url==='/'?'/index.html':q.url;let fp=p.join(d,u);f.readFile(fp,(e,c)=>{if(e){r.writeHead(404);r.end('Not found');return}r.writeHead(200,{'Content-Type':m[p.extname(fp)]||'application/octet-stream'});r.end(c)})}).listen(3333,()=>console.log('Serving on 3333'))"],
      "port": 3333
    }
  ]
}
